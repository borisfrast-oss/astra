# Master Dark Template
requires 1.2.0
convert {{ input_frames | join(' ') }} -out=stacked
stack stacked -method=average -norm=no -rejection=winsorized {{ dark_arg }} -out="{{ output }}"

# Master Bias Template
requires 1.2.0
convert {{ input_frames | join(' ') }} -out=stacked
stack stacked -method=average -norm=no -rejection=winsorized -out="{{ output }}"

# Master Flat Template
requires 1.2.0
convert {{ input_frames | join(' ') }} -out=stacked
stack stacked -method=average -norm=mul -rejection=winsorized {{ dark_arg }} -out="{{ output }}"

# Master Dark Flat Template
requires 1.2.0
convert {{ input_frames | join(' ') }} -out=stacked
stack stacked -method=average -norm=no -rejection=winsorized -out="{{ output }}"

# Calibrate Lights Template
requires 1.2.0
calibrate "{{ light }}" -dark={{ dark }} -flat={{ flat }} -bias={{ bias }} -out="{{ output }}"

# Registration Template
requires 1.2.0
register "{{ frame }}" -ref="{{ ref_frame }}" -method={{ method }} -out="{{ output }}"

# Stacking Template
requires 1.2.0
stack {{ input_frames | join(' ') }} -method={{ method }} -rejection={{ rejection }} -norm={{ normalization }} -weight={{ weight }} -out="{{ output }}"

# Background Extraction Template
requires 1.2.0
background "{{ input }}" -method=dbe -out="{{ output }}"

# Photometric Color Calibration Template
requires 1.2.0
photometriccolorcalibration "{{ input }}" -out="{{ output }}"

# Stretch Template
requires 1.2.0
stretch "{{ input }}" -method={{ method }} -factor={{ factor }} -out="{{ output }}"

# Export FITS Template
requires 1.2.0
save "{{ input }}" "{{ output }}" -fmt=fit

# Export TIFF Template
requires 1.2.0
save "{{ input }}" "{{ output }}" -fmt=tif -bits=16

# Export JPEG Template
requires 1.2.0
save "{{ input }}" "{{ output }}" -fmt=jpg -quality=95