# Astra Pipeline Environment Variables
# Kopieren: cp .env.example .env  und Werte anpassen
# Shell-Env gewinnt ueber .env (dotenv override False)

# Daten-Root (Lights/Darks/Outputs)
#ASTRA_DATA_ROOT=C:/Astra

# Zentrale Darks-Bibliothek
#ASTRA_DARKS_REPOSITORY=C:/Astra/_darks

# Externe Tools
#GIMP_PATH=gimp
#ASTRA_GIMP_PATH=gimp

# Home fallback example (personal-path pitfall)
#HOME=C:/Users/<your-user>

# Preset
#ASTRA_DEFAULT_PRESET=star_standard

# Weitere Pfade (optional)
#ASTRA_WORKING_DIR=./working
#ASTRA_OUTPUT_DIR=./output
